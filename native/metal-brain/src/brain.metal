#include <metal_stdlib>
using namespace metal;
struct Params { uint n; float alpha; float gain; float dt; float recovery; uint final_step; uint active_mask; };
kernel void project_inputs(device const uint *ptr [[buffer(0)]], device const uint *cols [[buffer(1)]], device const float *weights [[buffer(2)]], device const float4 *channels [[buffer(3)]], device float4 *drive [[buffer(4)]], constant Params &p [[buffer(8)]], uint row [[thread_position_in_grid]]) { if(row>=p.n)return;float4 x=0.0f;for(uint e=ptr[row];e<ptr[row+1];++e)x+=weights[e]*channels[cols[e]];drive[row]=x; }
kernel void csr_rate(device const uint *rowptr [[buffer(0)]], device const uint *columns [[buffer(1)]], device const float *weights [[buffer(2)]], device const float4 *rate_in [[buffer(3)]], device float4 *rate_out [[buffer(4)]], device float4 *adapt [[buffer(5)]], device float4 *support [[buffer(6)]], device const float4 *drive [[buffer(7)]], constant Params &p [[buffer(8)]], uint row [[thread_position_in_grid]]) { if(row>=p.n)return;float4 recurrent=0.0f;for(uint e=rowptr[row];e<rowptr[row+1];++e)recurrent+=weights[e]*rate_in[columns[e]];float4 old=rate_in[row],a=adapt[row],s=support[row];float4 target=max(tanh(0.005f+drive[row]+p.gain*recurrent-0.10f*a),0.0f);float4 next=old+p.alpha*(target*s-old);for(uint j=0;j<3;++j)if((p.active_mask&(1u<<j))==0)next[j]=old[j];next.w=0.0f;rate_out[row]=next;if(p.final_step){float4 na=a+p.dt/5.0f*(next-a),ns=clamp(s+p.dt*(p.recovery*(1.0f-s)-0.003f*next),0.65f,1.0f);for(uint j=0;j<3;++j)if((p.active_mask&(1u<<j))==0){na[j]=a[j];ns[j]=s[j];}adapt[row]=na;support[row]=ns;} }
kernel void csr_rate_simd(device const uint *rowptr [[buffer(0)]],device const uint *columns [[buffer(1)]],device const float *weights [[buffer(2)]],device const float4 *rate_in [[buffer(3)]],device float4 *rate_out [[buffer(4)]],device float4 *adapt [[buffer(5)]],device float4 *support [[buffer(6)]],device const float4 *drive [[buffer(7)]],constant Params &p [[buffer(8)]],uint gid [[thread_position_in_grid]],uint lane [[thread_index_in_simdgroup]]) {uint row=gid>>5;if(row>=p.n)return;float4 recurrent=0.0f;for(uint e=rowptr[row]+lane;e<rowptr[row+1];e+=32)recurrent+=weights[e]*rate_in[columns[e]];recurrent=float4(simd_sum(recurrent.x),simd_sum(recurrent.y),simd_sum(recurrent.z),0.0f);if(lane)return;float4 old=rate_in[row],a=adapt[row],s=support[row];float4 target=max(tanh(0.005f+drive[row]+p.gain*recurrent-0.10f*a),0.0f);float4 next=old+p.alpha*(target*s-old);for(uint j=0;j<3;++j)if((p.active_mask&(1u<<j))==0)next[j]=old[j];next.w=0.0f;rate_out[row]=next;if(p.final_step){float4 na=a+p.dt/5.0f*(next-a),ns=clamp(s+p.dt*(p.recovery*(1.0f-s)-0.003f*next),0.65f,1.0f);for(uint j=0;j<3;++j)if((p.active_mask&(1u<<j))==0){na[j]=a[j];ns[j]=s[j];}adapt[row]=na;support[row]=ns;}}
kernel void csr_rate_corrected(device const uint *rowptr [[buffer(0)]],device const uint *columns [[buffer(1)]],device const float *weights [[buffer(2)]],device const float4 *rate_in [[buffer(3)]],device float4 *rate_out [[buffer(4)]],device float4 *adapt [[buffer(5)]],device float4 *support [[buffer(6)]],device const float4 *drive [[buffer(7)]],constant Params &p [[buffer(8)]],device const uint *targets [[buffer(9)]],device const float4 *corrections [[buffer(10)]],uint row [[thread_position_in_grid]]) {if(row>=p.n)return;float4 recurrent=0.0f;for(uint e=rowptr[row];e<rowptr[row+1];++e)recurrent+=weights[e]*rate_in[columns[e]];if(row==targets[0])recurrent+=corrections[0];else if(row==targets[1])recurrent+=corrections[1];float4 old=rate_in[row],a=adapt[row],s=support[row];float4 target=max(tanh(0.005f+drive[row]+p.gain*recurrent-0.10f*a),0.0f);float4 next=old+p.alpha*(target*s-old);for(uint j=0;j<3;++j)if((p.active_mask&(1u<<j))==0)next[j]=old[j];next.w=0.0f;rate_out[row]=next;if(p.final_step){float4 na=a+p.dt/5.0f*(next-a),ns=clamp(s+p.dt*(p.recovery*(1.0f-s)-0.003f*next),0.65f,1.0f);for(uint j=0;j<3;++j)if((p.active_mask&(1u<<j))==0){na[j]=a[j];ns[j]=s[j];}adapt[row]=na;support[row]=ns;}}
kernel void csr_rate_simd_corrected(device const uint *rowptr [[buffer(0)]],device const uint *columns [[buffer(1)]],device const float *weights [[buffer(2)]],device const float4 *rate_in [[buffer(3)]],device float4 *rate_out [[buffer(4)]],device float4 *adapt [[buffer(5)]],device float4 *support [[buffer(6)]],device const float4 *drive [[buffer(7)]],constant Params &p [[buffer(8)]],device const uint *targets [[buffer(9)]],device const float4 *corrections [[buffer(10)]],uint gid [[thread_position_in_grid]],uint lane [[thread_index_in_simdgroup]]) {uint row=gid>>5;if(row>=p.n)return;float4 recurrent=0.0f;for(uint e=rowptr[row]+lane;e<rowptr[row+1];e+=32)recurrent+=weights[e]*rate_in[columns[e]];recurrent=float4(simd_sum(recurrent.x),simd_sum(recurrent.y),simd_sum(recurrent.z),0.0f);if(lane)return;if(row==targets[0])recurrent+=corrections[0];else if(row==targets[1])recurrent+=corrections[1];float4 old=rate_in[row],a=adapt[row],s=support[row];float4 target=max(tanh(0.005f+drive[row]+p.gain*recurrent-0.10f*a),0.0f);float4 next=old+p.alpha*(target*s-old);for(uint j=0;j<3;++j)if((p.active_mask&(1u<<j))==0)next[j]=old[j];next.w=0.0f;rate_out[row]=next;if(p.final_step){float4 na=a+p.dt/5.0f*(next-a),ns=clamp(s+p.dt*(p.recovery*(1.0f-s)-0.003f*next),0.65f,1.0f);for(uint j=0;j<3;++j)if((p.active_mask&(1u<<j))==0){na[j]=a[j];ns[j]=s[j];}adapt[row]=na;support[row]=ns;}}
kernel void gather_rates(device const float4 *rates [[buffer(0)]],device const uint *indices [[buffer(1)]],device float4 *selected [[buffer(2)]],uint i [[thread_position_in_grid]]) {selected[i]=rates[indices[i]];}
kernel void project_readouts(device const uint *ptr [[buffer(0)]], device const uint *cols [[buffer(1)]], device const float *weights [[buffer(2)]], device const float4 *rates [[buffer(3)]], device float4 *output [[buffer(4)]], uint row [[thread_position_in_grid]]) { if(row>=384)return;float4 x=0.0f;for(uint e=ptr[row];e<ptr[row+1];++e)x+=weights[e]*rates[cols[e]];output[row]=x; }
kernel void physiology_partials(device const float4 *rates [[buffer(0)]],device const float4 *support [[buffer(1)]],device float4 *partial [[buffer(2)]],constant Params &p [[buffer(8)]],uint gid [[thread_position_in_grid]],uint lane [[thread_index_in_threadgroup]],uint group [[threadgroup_position_in_grid]]) {threadgroup float4 sums[256],peaks[256],supports[256];float4 r=gid<p.n?rates[gid]:0.0f;sums[lane]=r;peaks[lane]=r;supports[lane]=gid<p.n?support[gid]:0.0f;threadgroup_barrier(mem_flags::mem_threadgroup);for(uint stride=128;stride;stride>>=1){if(lane<stride){sums[lane]+=sums[lane+stride];peaks[lane]=max(peaks[lane],peaks[lane+stride]);supports[lane]+=supports[lane+stride];}threadgroup_barrier(mem_flags::mem_threadgroup);}if(lane==0){partial[group*3]=sums[0];partial[group*3+1]=peaks[0];partial[group*3+2]=supports[0];}}
kernel void physiology_final(device const float4 *partial [[buffer(0)]],device float4 *output [[buffer(1)]],constant Params &p [[buffer(8)]],uint gid [[thread_position_in_grid]]) {if(gid>0)return;uint groups=(p.n+255)/256;float4 sum=0.0f,peak=0.0f,support=0.0f;for(uint g=0;g<groups;++g){sum+=partial[g*3];peak=max(peak,partial[g*3+1]);support+=partial[g*3+2];}output[384]=sum/p.n;output[385]=peak;output[386]=support/p.n;}
